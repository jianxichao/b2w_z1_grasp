Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.85
    Class: rviz_default_plugins/Map
    Color Scheme: map
    Draw Behind: true
    Enabled: true
    Name: 1 SLAM Map
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /navigation_map
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map_updates
    Use Timestamp: false
    Value: true
  - Class: rviz_default_plugins/Map
    Name: 2 Global Costmap
    Enabled: true
    Value: true
    Alpha: 0.5
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /global_costmap/costmap
    Update Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /global_costmap/costmap_updates
    Use Timestamp: false
  - Class: rviz_default_plugins/Map
    Name: 3 Local Costmap
    Enabled: false
    Value: false
    Alpha: 0.5
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /local_costmap/costmap
    Update Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /local_costmap/costmap_updates
    Use Timestamp: false
  - Alpha: 0.9
    Autocompute Intensity Bounds: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/LaserScan
    Color: 255; 80; 20
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Name: 4 Live Scan
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 4
    Size (m): 0.03
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /scan
    Value: true
  - Alpha: 1
    Axes Length: 0.45
    Axes Radius: 0.04
    Class: rviz_default_plugins/Pose
    Color: 255; 50; 20
    Enabled: true
    Head Length: 0.25
    Head Radius: 0.1
    Name: 5 Robot Pose
    Shaft Length: 0.45
    Shaft Radius: 0.05
    Shape: Arrow
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /slam/current_pose
    Value: true
  - Class: rviz_default_plugins/Polygon
    Name: 6 Nav2 Footprint
    Enabled: true
    Value: true
    Color: 0; 255; 255
    Alpha: 1.0
    Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /global_costmap/published_footprint
  - Class: rviz_default_plugins/PointCloud2
    Name: 7 Raw Lidar (toggle for 3D)
    Enabled: false
    Value: false
    Alpha: 0.8
    Color Transformer: AxisColor
    Axis: Z
    Position Transformer: XYZ
    Style: Points
    Size (Pixels): 2
    Size (m): 0.02
    Decay Time: 0
    Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /b2w/lidar/points
    Use Fixed Frame: true
    Use rainbow: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 0
      Name: Top Down
      Scale: 110
      Target Frame: <Fixed Frame>
      X: 0.0
      Y: 0.0
      Value: TopDownOrtho (rviz)
    Saved: null
Window Geometry:
  Height: 900
  Width: 1400
