[Unit]
Description=Unitree Mid360 driver
Requires=unitree-slam.service
After=unitree-slam.service

[Service]
Type=simple
User=unitree
Group=unitree
WorkingDirectory=/unitree/module/unitree_slam/bin
Environment=LD_LIBRARY_PATH=/home/unitree/cyclonedds_ws/install/cyclonedds/lib:/usr/local/lib
ExecStartPre=/bin/sleep 4
ExecStart=/unitree/module/unitree_slam/bin/mid360_driver
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

